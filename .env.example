# Local development defaults. Copy this file to .env before starting Compose.
# The mock provider and disabled auth require no external credentials.

# App runtime and LLM
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_BASE_URL=
LLM_URL=
NORMA_LLM_MODEL=
NORMA_OUTPUT_DIR=features
NORMA_FEATURE_DIR=features
NORMA_ARTIFACT_DIR=.runtime/artifacts
NORMA_IMPORT_DIR=.runtime/imports
NORMA_IMPORT_DB=.runtime/import_jobs.sqlite3
NORMA_GENERATION_PROVIDER=
NORMA_GENERATION_MODEL=gpt-4o-mini
NORMA_GENERATION_WORKERS=2
NORMA_GENERATION_QUEUE_SIZE=8
NORMA_GENERATION_ABANDON_TIMEOUT_SECONDS=3600
NORMA_GENERATION_PROVIDER_TIMEOUT_SECONDS=30
NORMA_GENERATION_PROVIDER_MAX_RETRIES=2
NORMA_GENERATION_PROVIDER_RETRY_BASE_SECONDS=0.5
NORMA_GENERATION_PROVIDER_RETRY_MAX_SECONDS=8
NORMA_GENERATION_CIRCUIT_FAILURE_THRESHOLD=3
NORMA_GENERATION_CIRCUIT_RESET_SECONDS=30
NORMA_UPLOAD_RATE_LIMIT=30
NORMA_GENERATION_RATE_LIMIT=10
NORMA_RATE_LIMIT_WINDOW_SECONDS=60
NORMA_RETENTION_CLEANUP_ENABLED=false
NORMA_ARTIFACT_RETENTION_DAYS=30
NORMA_IMPORT_RETENTION_DAYS=30
ANTINODE_FAILURE_DB_FILE=.runtime/failures.sqlite3

# Optional LLM credentials. Unused while LLM_PROVIDER=mock.
ANTHROPIC_API_KEY=changeme
OPENAI_API_KEY=changeme
OPENROUTER_API_KEY=changeme
GEMINI_API_KEY=changeme
GOOGLE_API_KEY=changeme
GROQ_API_KEY=changeme
MISTRAL_API_KEY=changeme

# Auth: keep disabled for local development.
NORMA_ENVIRONMENT=development
NORMA_AUTH_MODE=disabled
NORMA_AUTH_ALLOW_IDENTITY_HEADERS=false
# Local synthetic user role: viewer, generator, reviewer, or admin.
# Elevated roles are for isolated local development only; never use in production.
NORMA_AUTH_LOCAL_ROLE=viewer
# Used only in OIDC mode; include each browser origin exactly (scheme, host, port).
NORMA_AUTH_ALLOWED_ORIGINS=

# Database: the hostname "db" is the Compose service, not the WSL host.
DATABASE_URL=postgresql://norma:norma-local-only@db:5432/norma

# Observability
# The app exposes /health and /metrics; it currently reads no app-specific
# observability environment variables. Prometheus/Grafana are separate services.

# OIDC placeholders. Leave unused unless NORMA_AUTH_MODE=oidc.
NORMA_OIDC_ISSUER=
NORMA_OIDC_DISCOVERY_URL=
NORMA_OIDC_CLIENT_ID=
NORMA_OIDC_CLIENT_SECRET=changeme
NORMA_OIDC_REDIRECT_URI=

# Code generator. CODEGEN_ option names map to CodegenConfig fields, with
# QUALITY_ mapped to QualityConfig fields; parser/emitter option keys are extensible.
CODEGEN_CONFIG_FILE=
CODEGEN_DEFAULT_FRAMEWORK=playwright
CODEGEN_FEATURE_DIR=features
CODEGEN_OUTPUT_DIR=generated_tests
CODEGEN_BASE_URL=
CODEGEN_FRAMEWORK_OUTPUT_MAP={"playwright":"playwright","cypress":"cypress","selenium":"selenium"}
CODEGEN_DOMAIN=
CODEGEN_PROMPT_VERSION=latest
CODEGEN_PARSER_OPTIONS={}
CODEGEN_EMITTER_OPTIONS={}
CODEGEN_VERBOSE=false
CODEGEN_DRY_RUN=false
CODEGEN_LOG_LEVEL=INFO
CODEGEN_QUALITY_USE_PAGE_OBJECTS=true
CODEGEN_QUALITY_GENERATE_STEP_DEFS=true
CODEGEN_QUALITY_SELECTOR_STRATEGY=data-testid
CODEGEN_QUALITY_ADD_EXPLICIT_WAITS=true
CODEGEN_QUALITY_ENABLE_SCENARIO_OUTLINES=true
CODEGEN_QUALITY_RUN_FORMATTER=false
CODEGEN_QUALITY_FORMATTER_TOOL=prettier
CODEGEN_QUALITY_RUN_LINTER=false
CODEGEN_QUALITY_LINTER_TOOL=null
CODEGEN_QUALITY_PAGE_OBJECT_DIR=pages
CODEGEN_QUALITY_STEP_DEF_DIR=steps
CODEGEN_QUALITY_OUTPUT_TEMPLATES=false
CODEGEN_QUALITY_USE_LLM_MAPPING=false
CODEGEN_QUALITY_LLM_MAPPING_CACHE_SIZE=1000
CODEGEN_QUALITY_LLM_MAPPING_TIMEOUT=5
CODEGEN_QUALITY_ENABLE_SELF_HEALING=false
CODEGEN_QUALITY_ENABLE_VISUAL_TESTING=false
CODEGEN_QUALITY_ENABLE_FAILURE_LEARNING=true
CODEGEN_QUALITY_FAILURE_LEARNING_MAX_EXAMPLES=2
CODEGEN_QUALITY_VISUAL_SNAPSHOT_DIR=visual-snapshots
CODEGEN_QUALITY_SELECTOR_HEALING_CACHE_SIZE=1000
CODEGEN_QUALITY_WAIT_TIMEOUT=10000
CODEGEN_QUALITY_RETRY_COUNT=2
# Feature flags default off; uncomment/set true to enable a flag.
NORMA_FEATURE_UNIFIED_AGENT=false
NORMA_FEATURE_CACHE_EXACT=false
NORMA_FEATURE_CACHE_SEMANTIC=false
NORMA_FEATURE_GOVERNANCE_AUDIT=false
NORMA_FEATURE_GOVERNANCE_APPROVAL=false
NORMA_FEATURE_AUTH_SAML=false
NORMA_FEATURE_EXECUTION_CLOUD=false
NORMA_FEATURE_EDGE_DISCOVERY=false
NORMA_FEATURE_KNOWLEDGE_GRAPH=false
NORMA_FEATURE_AEGIS_GOVERNANCE=false

# Optional integrations
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_TOKEN=changeme
TESTRAIL_URL=https://your-domain.testrail.io
TESTRAIL_USER=changeme
TESTRAIL_TOKEN=changeme
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=changeme
XRAY_CLIENT_SECRET=changeme
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Optional cloud browser providers. Set only the pair for the selected provider.
BROWSERSTACK_USERNAME=changeme
BROWSERSTACK_ACCESS_KEY=changeme
SAUCELABS_USERNAME=changeme
SAUCELABS_ACCESS_KEY=changeme
LAMBDATEST_USERNAME=changeme
LAMBDATEST_ACCESS_KEY=changeme